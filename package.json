{
  "name": "eal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "devctl": "bun packages/devctl/index.ts",
    "verify": "bun packages/devctl/index.ts verify",
    "verify:estimate": "bunx polly verify --estimate",
    "verify:validate": "bunx polly verify --validate",
    "gallery": "polly gallery",
    "mutation": "stryker run",
    "mutation:specs": "stryker run stryker/specs.conf.json",
    "mutation:shared": "stryker run stryker/shared.conf.json",
    "mutation:cli-lib": "stryker run stryker/cli-lib.conf.json",
    "mutation:web-logic": "stryker run stryker/web-logic.conf.json",
    "mutation:handlers-shared": "stryker run stryker/handlers-shared.conf.json",
    "mutation:report": "polly mutate report",
    "mutation:verify": "polly mutate verify"
  },
  "devDependencies": {
    "@eal/shared": "workspace:*",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "1.4.2",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.9.0",
    "puppeteer": "^25.10.0",
    "stryker-mutator-bun-runner": "0.4.0",
    "typescript": "7.0.2",
    "typescript-legacy-api": "npm:typescript@6.0.3"
  },
  "//patchedDependencies": "@stryker-mutator/core is patched to import the TypeScript JS API from the typescript-legacy-api alias (typescript@6.0.3). TS 7 ships the native compiler and exports only version/versionMajorMinor, so Stryker's TSConfigPreprocessor throws without it. tsc on the CLI stays on 7.x. See OPEN_TASKS.md, Dependencies on hold.",
  "patchedDependencies": {
    "stryker-mutator-bun-runner@0.4.0": "patches/stryker-mutator-bun-runner@0.4.0.patch",
    "@stryker-mutator/core@10.0.0": "patches/@stryker-mutator%2Fcore@10.0.0.patch"
  },
  "catalog": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.2"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@fairfox/polly": "0.91.0"
  }
}
