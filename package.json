{
  "name": "eal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "devctl": "bun packages/devctl/index.ts",
    "verify": "bun packages/devctl/index.ts verify",
    "verify:estimate": "bunx polly verify --estimate",
    "verify:validate": "bunx polly verify --validate",
    "gallery": "polly gallery",
    "mutation": "stryker run",
    "mutation:specs": "stryker run stryker/specs.conf.json",
    "mutation:shared": "stryker run stryker/shared.conf.json",
    "mutation:cli-lib": "stryker run stryker/cli-lib.conf.json",
    "mutation:web-logic": "stryker run stryker/web-logic.conf.json",
    "mutation:handlers-shared": "stryker run stryker/handlers-shared.conf.json",
    "mutation:report": "polly mutate report",
    "mutation:verify": "polly mutate verify"
  },
  "devDependencies": {
    "@eal/shared": "workspace:*",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "1.4.2",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.9.0",
    "puppeteer": "^25.10.0",
    "stryker-mutator-bun-runner": "0.4.0",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "stryker-mutator-bun-runner@0.4.0": "patches/stryker-mutator-bun-runner@0.4.0.patch"
  },
  "//overrides": "@fairfox/polly declares preact, @preact/signals and @preact/signals-core as both exact hard dependencies and peer dependencies. Without these overrides a newer version here installs a second copy and preact hooks break. Drop this block when polly stops hard-pinning them. See OPEN_TASKS.md, Dependencies on hold.",
  "overrides": {
    "preact": "10.29.8",
    "@preact/signals": "2.11.2",
    "@preact/signals-core": "1.14.4"
  },
  "catalog": {
    "typescript": "6.0.3",
    "@types/bun": "1.4.2"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@fairfox/polly": "0.90.0"
  }
}
