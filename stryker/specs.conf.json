{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "bun",
  "plugins": ["stryker-mutator-bun-runner", "@fairfox/polly/stryker"],
  "ignorers": ["polly-verify"],
  "bun": {
    "testFiles": ["packages/api/src/specs/**/*.test.ts"],
    "env": { "SKIP_TLS": "1" },
    "timeout": 30000
  },
  "coverageAnalysis": "all",
  "disableBail": true,
  "checkers": [],
  "reporters": ["json", "clear-text", "progress"],
  "mutate": [
    "packages/api/src/specs/auth-machine.ts",
    "packages/api/src/specs/auth-gate-machine.ts",
    "packages/api/src/specs/call-machine.ts",
    "packages/api/src/specs/ws-machine.ts",
    "packages/api/src/specs/pairing-machine.ts",
    "packages/api/src/specs/sessions-machine.ts"
  ],
  "thresholds": { "high": 90, "low": 70, "break": null },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/.stryker-tmp/**",
    "**/reports/**"
  ],
  "timeoutMS": 30000,
  "concurrency": 2
}
