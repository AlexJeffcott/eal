{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "bun",
  "plugins": ["stryker-mutator-bun-runner"],
  "bun": {
    "testFiles": [
      "packages/web/src/actions/**/*.test.ts",
      "packages/web/src/apps/tasks/**/*.test.ts"
    ],
    "env": { "SKIP_TLS": "1" },
    "timeout": 30000
  },
  "coverageAnalysis": "all",
  "disableBail": true,
  "checkers": [],
  "reporters": ["json", "clear-text", "progress"],
  "mutate": [
    "packages/web/src/actions/registry.ts",
    "packages/web/src/apps/tasks/filter.ts"
  ],
  "thresholds": { "high": 90, "low": 70, "break": null },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/.stryker-tmp/**",
    "**/reports/**"
  ],
  "timeoutMS": 30000,
  "concurrency": 2
}
