{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "bun",
  "plugins": ["stryker-mutator-bun-runner"],
  "bun": {
    "testFiles": ["packages/cli/src/lib/**/*.test.ts"],
    "env": { "SKIP_TLS": "1" },
    "timeout": 30000
  },
  "coverageAnalysis": "all",
  "disableBail": true,
  "checkers": [],
  "reporters": ["json", "clear-text", "progress"],
  "mutate": [
    "packages/cli/src/lib/audio-resample.ts",
    "packages/cli/src/lib/wav.ts",
    "packages/cli/src/lib/split-args.ts",
    "packages/cli/src/lib/agent-key-import.ts",
    "packages/cli/src/lib/token-store.ts",
    "packages/cli/src/lib/agent-device-store.ts"
  ],
  "thresholds": { "high": 90, "low": 70, "break": null },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/.stryker-tmp/**",
    "**/reports/**"
  ],
  "timeoutMS": 30000,
  "concurrency": 2
}
